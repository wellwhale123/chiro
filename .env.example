# 관리자 모드 진입 비밀번호 (운영진이 로고 5번 클릭 후 입력)
ADMIN_PASSWORD=

# 관리자 세션 쿠키 서명에 쓰이는 비밀키 (아무 랜덤 문자열, 예: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# 개강총회 신청 시 학교 이메일(@cau.ac.kr) 인증코드 발송용 SMTP 계정
# Gmail 사용 시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=본인 Gmail, SMTP_PASS=앱 비밀번호(2단계 인증 필요)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 비워두면 SMTP_USER를 발신자로 사용합니다.
SMTP_FROM=
