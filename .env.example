# Notion 연동 토큰 (기존 워크스페이스: 개강총회/교육/튜터링/스터디/IRC 신청 표 등)
NOTION_API_KEY=

# MT 신청 관련 데이터베이스(재영님 개인 워크스페이스) 전용 토큰
NOTION_API_KEY_MT=

# 새 워크스페이스 토큰 (일정/수상/활동/프로젝트/공지사항/운영진소개/동아리소개/졸업생/
# 명단/팝업 관리가 이 워크스페이스로 이전됨)
NOTION_API_KEY_NEW=

# 관리자 모드 진입 비밀번호 (운영진이 로고 5번 클릭 후 입력)
ADMIN_PASSWORD=

# 관리자 세션 쿠키 서명에 쓰이는 비밀키 (아무 랜덤 문자열, 예: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# 개강총회 신청 시 학교 이메일(@cau.ac.kr) 인증코드 발송용 SMTP 계정
# Gmail 사용 시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=본인 Gmail, SMTP_PASS=앱 비밀번호(2단계 인증 필요)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 비워두면 SMTP_USER를 발신자로 사용합니다.
SMTP_FROM=
